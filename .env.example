# Supabase 项目地址（Project URL）
# 控制台 → Settings → Data API（或 General）里的 Project URL，形如 https://abcdefgh.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 前端公钥（两种都行，填一个新的 publishable key 即可）
#   新版推荐：Publishable key，形如 sb_publishable_xxxxxxxxxx
#   旧版兼容：anon public key，形如 eyJhbGciOi...（2026 年底弃用）
# 取值：控制台 → Settings → API Keys
# ⚠️ 千万别填 Secret key / service_role key：那会绕过 RLS，拿到等于数据库裸奔
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxx

# 图片存储平台（可选，默认 supabase；切腾讯云填 cos）
# 换平台业务代码不用动，见 README「换存储不改业务代码」。
VITE_IMAGE_PROVIDER=supabase

# ---- 腾讯云 COS（VITE_IMAGE_PROVIDER=cos 时必填）----
# 桶的公网访问域名（控制台 → 桶 → 概览 → 访问域名），不带路径
VITE_COS_PUBLIC_BASE=https://your-bucket-1234567890.cos.ap-guangzhou.myqcloud.com
# 上传令牌：随便编一串长随机字符串，和 Netlify 服务端变量 UPLOAD_TOKEN 保持一致。
# 作用：Netlify Function 只认带这个头的请求，挡住路过的脚本。
# 注意：它会被打包进前端，是「防路过」级别，不是真认证；以后有登录体系要换掉。
VITE_UPLOAD_TOKEN=

# ---- 以下 5 个只配在 Netlify 后台（Site settings → Environment variables），
# ---- 绝不写进本地 .env、绝不带 VITE_ 前缀（否则密钥会被打包进前端公开）----
# COS_SECRET_ID / COS_SECRET_KEY   CAM 子账号密钥（编程访问 + QcloudCOSDataFullControl）
# COS_BUCKET                       完整桶名（带 APPID 后缀，如 bigcook-1311958566）
# COS_REGION                       地域（如 ap-guangzhou）
# UPLOAD_TOKEN                     和上面的 VITE_UPLOAD_TOKEN 同值

# Web Push 公钥（跟 Edge Function Secrets 里的 VAPID_PRIVATE_KEY 是一对）
# 用 node 生成：
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify'])
#     .then(async k=>console.log(await crypto.subtle.exportKey('pkcs8',k.privateKey),
#                                await crypto.subtle.exportKey('raw',k.publicKey)))"
# ⚠️ 私钥只能放 Supabase → Edge Functions → Secrets，绝不能带 VITE_ 前缀进前端
VITE_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
