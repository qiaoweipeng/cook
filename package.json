{
  "name": "cook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "push": "pnpm build && tcb hosting deploy dist -e cook-prod-d6g9njw6g0dadf473",
    "push:netlify": "pnpm build && npx netlify-cli deploy --prod --dir=dist",
    "seed": "esbuild scripts/seed.ts --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/seed.mjs --log-level=warning && node node_modules/.cache/seed.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.10.2",
    "antd": "^5.20.0",
    "antd-mobile": "^5.43.0",
    "antd-mobile-icons": "^0.3.0",
    "dayjs": "^1.11.13",
    "localforage": "^1.10.0",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^2.0.0"
  }
